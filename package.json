{
  "name": "settlement-service",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/index.js",
    "start:gateway": "node dist/mock-gateway/index.js",
    "start:all": "npm install && npm run build && node start-all.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "dev:gateway": "ts-node-dev --respawn --transpile-only mock-gateway/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.18.3",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "sql.js": "^1.12.0",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.30",
    "@types/sql.js": "^1.4.9",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.8",
    "supertest": "^7.0.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.3",
    "vitest": "^1.4.0"
  }
}
